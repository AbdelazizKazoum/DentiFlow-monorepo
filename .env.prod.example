# Copy to .env.prod and replace every value before deploying.

DOCKERHUB_USERNAME=abdelazizkazoum2
IMAGE_TAG=latest

MYSQL_ROOT_PASSWORD=change-this-mysql-root-password

JWT_SECRET=change-this-jwt-secret-at-least-32-characters
REFRESH_TOKEN_SECRET=change-this-refresh-secret-at-least-32-characters
NEXTAUTH_SECRET=change-this-nextauth-secret-at-least-32-characters
NEXTAUTH_SESSION_COOKIE_NAME=dentiflow-prod.session-token

# Optional. DB_PASSWORD defaults to MYSQL_ROOT_PASSWORD because the current
# MySQL init script grants service access to root.
# DB_USERNAME=root
# DB_PASSWORD=change-this-service-db-password

# Defaults shown for clarity.
FRONTEND_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_DEFAULT_CLINIC_ID=00000000-0000-4000-8000-000000000001

# Default test admin created by auth migrations.
# Set DENTIFLOW_SEED_DEFAULT_ADMIN=false to disable this seed.
DENTIFLOW_SEED_DEFAULT_ADMIN=true
DEFAULT_ADMIN_CLINIC_ID=00000000-0000-4000-8000-000000000001
DEFAULT_ADMIN_EMAIL=admin@dentiflow.local
DEFAULT_ADMIN_PASSWORD=Admin123!
DEFAULT_ADMIN_FULL_NAME=DentiFlow Admin

# Optional host binding overrides.
# PROD_BIND_ADDRESS=127.0.0.1
# PROD_FRONTEND_PORT=3000
# PROD_API_PORT=3001
